PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Supabase — Session pooler (Dashboard → Database → Connect → Session mode)
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD="tu-password-de-database"
DB_NAME=postgres
DB_SSL=true

# Alternativa: URI completa (password con caracteres raros debe ir URL-encoded)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage (producción en Render — el disco local es efímero)
# Dashboard → Project Settings → API → Project URL + service_role key (secret)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=promacson

# Producción: NODE_ENV=production y DB_SYNC=false (o omitir DB_SYNC)
# Solo desarrollo local:
# DB_SYNC=true

# Default admin seeded on first API start
ADMIN_EMAIL=admin@promacson.local
ADMIN_PASSWORD=changeme

# CORS: URL del front (Vercel). Varias separadas por coma.
CORS_ORIGIN=http://localhost:3000

SITE_PHONE=662 450 1230
SITE_PHONE_E164=+526624501230
SITE_EMAIL=ventas@promacson.mx
SITE_WHATSAPP=526624501230
SITE_ADDRESS=C. Benito Juárez 177, Constitución, 83150 Hermosillo, Son.
