PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL — preferir DATABASE_URL (Dashboard → Database → Connection string)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_SSL=true

# Alternativa sin URL:
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=postgres

# Solo desarrollo local (no usar en producción)
# DB_SYNC=true

# Default admin seeded on first API start
ADMIN_EMAIL=admin@promacson.local
ADMIN_PASSWORD=changeme

# CORS: URL del front (Vercel). Varias separadas por coma.
CORS_ORIGIN=http://localhost:3000

SITE_PHONE=662 450 1230
SITE_PHONE_E164=+526624501230
SITE_EMAIL=ventas@promacson.mx
SITE_WHATSAPP=526624501230
SITE_ADDRESS=C. Benito Juárez 177, Constitución, 83150 Hermosillo, Son.
