PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=promacson
DB_SSL=false

# Solo desarrollo: TypeORM crea/actualiza tablas. En el servidor: false y usa el SQL.
# DB_SYNC=true

# URL del front. Varias separadas por coma.
CORS_ORIGIN=http://localhost:3000

# Correo SMTP (Brevo). Sin MAIL_USER/MAIL_PASS no se envía.
# En servers que bloquean 587 usar MAIL_PORT=2525.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=
